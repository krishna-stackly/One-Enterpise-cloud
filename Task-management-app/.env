
# Application
APP_NAME=Stackly
APP_ENV=production

# Docker Hub
DOCKERHUB_USERNAME=adharaninikhil

# Semantic versions
APP_FRONTEND_VERSION=1.5.0
APP_BACKEND_VERSION=1.5.0

# Frontend build arguments
VITE_API_BASE_URL=/api
VITE_USE_MOCK=false

# Backend
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
CORS_ALLOWED_ORIGINS=http://oec-tm.stacklycloud.com,http://3.210.181.116,http://localhost:5173,http://127.0.0.1:5173

# MySQL - keep stable during application releases
MYSQL_DATABASE=stackly_pms
MYSQL_USER=stackly
MYSQL_PASSWORD=REPLACE_WITH_ROTATED_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_ROTATED_ROOT_PASSWORD

# Backend database connection
DB_HOST=mysql
DB_PORT=3306
DB_NAME=stackly_pms
DB_USERNAME=stackly
DB_PASSWORD=REPLACE_WITH_ROTATED_DATABASE_PASSWORD

# JWT
JWT_SECRET=REPLACE_WITH_A_NEW_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# File storage
FILE_STORAGE_TYPE=local
FILE_STORAGE_LOCAL_PATH=/app/uploads