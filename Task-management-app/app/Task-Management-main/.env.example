# Application
APP_NAME=Stackly
APP_ENV=development

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api
VITE_USE_MOCK=false

# Backend
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL
MYSQL_DATABASE=stackly_pms
MYSQL_USER=stackly
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stackly_pms
DB_USERNAME=stackly
DB_PASSWORD=change_me

# JWT — generate a long random secret for any non-local environment
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# File storage
FILE_STORAGE_TYPE=local
FILE_STORAGE_LOCAL_PATH=./uploads
# FILE_STORAGE_S3_BUCKET=
# FILE_STORAGE_S3_REGION=
# FILE_STORAGE_S3_ENDPOINT=
